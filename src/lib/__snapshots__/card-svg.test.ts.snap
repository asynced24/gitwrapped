    <clipPath id="gw-p0"><rect x="12" y="296" width="334" height="64" rx="10"/></clipPath><clipPath id="gw-p1"><rect x="12" y="366" width="334" height="80" rx="10"/></clipPath><clipPath id="gw-p2"><rect x="12" y="452" width="334" height="30" rx="7"/></clipPath>
  </defs>

  <g clip-path="url(#gw-card)">
