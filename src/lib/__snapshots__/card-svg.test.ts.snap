  <!-- Ability -->
  <text x="24" y="313" font-family="'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace" font-size="7.5" letter-spacing="2" fill="#4FE3A8">ABILITY</text>
