  <circle cx="29.5" cy="379.5" r="5.5" fill="#4FE3A8" stroke="rgba(255,255,255,0.35)"/><circle cx="43.5" cy="379.5" r="5.5" fill="#4FE3A8" stroke="rgba(255,255,255,0.35)"/>
