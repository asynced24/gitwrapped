exports[`renderCardSVG > renders asynced24's card unchanged 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="358" height="498" viewBox="0 0 358 498" fill="none">
  <defs>
    <style>
    @keyframes gw-sweep { 0% { transform: translateX(-160px) } 55%, 100% { transform: translateX(560px) } }
    @keyframes gw-twinkle { 0%, 100% { opacity: 0.15 } 50% { opacity: 0.95 } }
    @keyframes gw-pulse { 0%, 100% { stroke-opacity: 0.2 } 50% { stroke-opacity: 0.65 } }
    .gw-sweep { animation: gw-sweep 5.5s ease-in-out infinite; }
    .gw-twinkle { animation: gw-twinkle 2.4s ease-in-out infinite; }
    .gw-pulse { animation: gw-pulse 3s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) { .gw-sweep, .gw-twinkle, .gw-pulse { animation: none; } }
  </style>
    <linearGradient id="gw-sweepGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0"/>
      <stop offset="0.45" stop-color="#FFFFFF" stop-opacity="0.32"/>
      <stop offset="0.6" stop-color="#56D6FF" stop-opacity="0.22"/>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="gw-holo" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="358" y2="498">
      <stop offset="0" stop-color="#6E4F0E"/>
      <stop offset="0.38" stop-color="#C9971C"/>
      <stop offset="0.48" stop-color="#FFF4C2"/>
      <stop offset="0.58" stop-color="#C9971C"/>
      <stop offset="1" stop-color="#6E4F0E"/>
      <!-- The bright band travels around the frame: a glint, not a colour cycle. -->
      <animateTransform attributeName="gradientTransform" type="rotate" from="0 179 249" to="360 179 249" dur="6s" repeatCount="indefinite"/>
    </linearGradient>
    <linearGradient id="gw-theme" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3178C6"/>
      <stop offset="1" stop-color="#58A6FF"/>
    </linearGradient>
    <linearGradient id="gw-scrim" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#05080F" stop-opacity="0"/>
      <stop offset="0.55" stop-color="#05080F" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#05080F" stop-opacity="0.85"/>
    </linearGradient>
    <linearGradient id="gw-foil" x1="0" y1="0" x2="1" y2="0.7">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.090"/>
      <stop offset="0.28" stop-color="#56D6FF" stop-opacity="0.100"/>
      <stop offset="0.5" stop-color="#FFFFFF" stop-opacity="0"/>
      <stop offset="0.72" stop-color="#FF9FF0" stop-opacity="0.080"/>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0.060"/>
    </linearGradient>
    <filter id="gw-frost" x="-5%" y="-5%" width="110%" height="110%"><feGaussianBlur stdDeviation="7"/></filter>
    <filter id="gw-glow" x="-5%" y="-80%" width="110%" height="260%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="2.5" result="b"/>
      <feFlood flood-color="#56D6FF" flood-opacity="0.95"/>
      <feComposite in2="b" operator="in" result="g"/>
      <feMerge><feMergeNode in="g"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="gw-sparkle" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="3" result="b"/>
      <feFlood flood-color="#56D6FF" flood-opacity="0.9"/>
      <feComposite in2="b" operator="in" result="g"/>
      <feMerge><feMergeNode in="g"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="gw-shadow" x="-20%" y="-20%" width="140%" height="160%">
      <feDropShadow dx="0" dy="1" stdDeviation="1.5" flood-color="#000000" flood-opacity="0.7"/>
    </filter>
    <filter id="gw-lift" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.55"/>
    </filter>
    <clipPath id="gw-card"><rect width="358" height="498" rx="20"/></clipPath>
    <clipPath id="gw-avatar"><circle cx="179" cy="132" r="40"/></clipPath>
    <clipPath id="gw-p0"><rect x="12" y="296" width="334" height="64" rx="10"/></clipPath><clipPath id="gw-p1"><rect x="12" y="366" width="334" height="80" rx="10"/></clipPath><clipPath id="gw-p2"><rect x="12" y="452" width="334" height="30" rx="7"/></clipPath>
  </defs>

  <g clip-path="url(#gw-card)">
