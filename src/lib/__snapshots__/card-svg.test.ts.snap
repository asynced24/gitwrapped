  <rect x="24" y="406" width="310" height="1" fill="rgba(255,255,255,0.09)"/>
  <circle cx="29.5" cy="417.5" r="5.5" fill="#56D6FF" stroke="rgba(255,255,255,0.35)"/><circle cx="43.5" cy="417.5" r="5.5" fill="#56D6FF" stroke="rgba(255,255,255,0.35)"/>
  <text x="58" y="422" font-family="'Archivo Black', 'Arial Black', 'Segoe UI Black', sans-serif" font-size="12.5" fill="#FFFFFF">Thunder Compile</text>
  <text x="58" y="435" font-family="'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace" font-size="8" fill="#93A5C0">Powered by gitwrapped - ★ 1</text>
  <text x="334" y="431" text-anchor="end" font-family="'Archivo Black', 'Arial Black', 'Segoe UI Black', sans-serif" font-size="21" fill="#FFFFFF" filter="url(#gw-shadow)">30</text>

  <!-- Weakness / resist / retreat -->
  <text x="67.7" y="471.5" text-anchor="middle" font-family="'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace"><tspan font-size="7" letter-spacing="1" fill="#7E90AB">WEAKNESS</tspan><tspan font-size="9.5" fill="#9AA7B8" dx="6">●</tspan><tspan font-size="9.5" fill="#C7D2E2" dx="4">×2</tspan></text>
  <rect x="123.3" y="459" width="1" height="16" fill="rgba(255,255,255,0.09)"/>
  <text x="179.0" y="471.5" text-anchor="middle" font-family="'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace"><tspan font-size="7" letter-spacing="1" fill="#7E90AB">RESIST</tspan><tspan font-size="9.5" fill="#9AA7B8" dx="6">●</tspan><tspan font-size="9.5" fill="#C7D2E2" dx="4">-30</tspan></text>
  <rect x="234.7" y="459" width="1" height="16" fill="rgba(255,255,255,0.09)"/>
  <text x="290.3" y="471.5" text-anchor="middle" font-family="'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace"><tspan font-size="7" letter-spacing="1" fill="#7E90AB">RETREAT</tspan><tspan font-size="9.5" fill="#56D6FF" dx="6" letter-spacing="1">●●●</tspan></text>

  <!-- Footer -->
  <text x="18" y="492" font-family="'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace" font-size="8" fill="#A9B8CE" filter="url(#gw-shadow)">gitwrapped · The Steps · 1 of 1</text>
  <text x="340" y="492" text-anchor="end" font-family="'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace" font-size="8" letter-spacing="1" fill="#F5C518" filter="url(#gw-shadow)">◆ ONE OF ONE</text>
  </g>

  <!-- Rarity frame -->
  <rect x="1.75" y="1.75" width="354.5" height="494.5" rx="18.25" stroke="url(#gw-holo)" stroke-opacity="0.9" stroke-width="3.5"/>
</svg>"
`;

exports[`renderCardSVG > renders gaearon's card unchanged 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="358" height="498" viewBox="0 0 358 498" fill="none">
  <defs>
    <style>
    @keyframes gw-sweep { 0% { transform: translateX(-160px) } 55%, 100% { transform: translateX(560px) } }
    @keyframes gw-twinkle { 0%, 100% { opacity: 0.15 } 50% { opacity: 0.95 } }
    @keyframes gw-pulse { 0%, 100% { stroke-opacity: 0.2 } 50% { stroke-opacity: 0.65 } }
    .gw-sweep { animation: gw-sweep 5.5s ease-in-out infinite; }
    .gw-twinkle { animation: gw-twinkle 2.4s ease-in-out infinite; }
    .gw-pulse { animation: gw-pulse 3s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) { .gw-sweep, .gw-twinkle, .gw-pulse { animation: none; } }
  </style>
    <linearGradient id="gw-sweepGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0"/>
      <stop offset="0.45" stop-color="#FFFFFF" stop-opacity="0.32"/>
      <stop offset="0.6" stop-color="#B78CFF" stop-opacity="0.22"/>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
