  <polyline points="8.0,277.0 14.6,277.0 21.2,273.3 27.7,271.8 34.3,277.0 40.9,277.0 47.5,277.0 54.0,277.0 60.6,277.0 67.2,277.0 73.8,277.0 80.3,277.0 86.9,277.0 93.5,277.0 100.1,266.2 106.7,277.0 113.2,272.5 119.8,277.0 126.4,266.5 133.0,262.9 139.5,263.6 146.1,262.4 152.7,277.0 159.3,270.1 165.8,273.3 172.4,277.0 179.0,273.3 185.6,277.0 192.2,277.0 198.7,277.0 205.3,277.0 211.9,277.0 218.5,270.1 225.0,271.1 231.6,257.5 238.2,247.9 244.8,260.8 251.3,261.0 257.9,267.9 264.5,268.3 271.1,267.2 277.7,277.0 284.2,267.5 290.8,271.1 297.4,265.3 304.0,260.8 310.5,254.3 317.1,261.9 323.7,255.4 330.3,257.2 336.8,251.4 343.4,246.1 350.0,243.0" stroke="#EAFBFF" stroke-opacity="0.95" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" filter="url(#gw-glow)"/>

  <!-- Avatar: large circle over the art -->
