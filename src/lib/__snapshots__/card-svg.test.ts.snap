  <circle cx="179" cy="132" r="40" fill="#3178C6"/><text x="179" y="143" text-anchor="middle" font-family="'Archivo Black', 'Arial Black', 'Segoe UI Black', sans-serif" font-size="30" fill="#FFFFFF">A</text>
