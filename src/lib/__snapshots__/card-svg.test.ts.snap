  <polyline points="8.0,265.5 14.6,246.5 21.2,255.8 27.7,277.0 34.3,269.8 40.9,277.0 47.5,263.2 54.0,273.2 60.6,277.0 67.2,277.0 73.8,267.6 80.3,269.3 86.9,258.0 93.5,266.1 100.1,277.0 106.7,271.6 113.2,257.2 119.8,258.8 126.4,262.9 133.0,270.9 139.5,270.9 146.1,268.9 152.7,270.4 159.3,273.2 165.8,258.8 172.4,277.0 179.0,272.3 185.6,277.0 192.2,277.0 198.7,272.3 205.3,277.0 211.9,277.0 218.5,277.0 225.0,277.0 231.6,277.0 238.2,277.0 244.8,277.0 251.3,277.0 257.9,268.0 264.5,268.4 271.1,262.9 277.7,262.1 284.2,259.8 290.8,257.8 297.4,260.9 304.0,264.0 310.5,270.9 317.1,243.0 323.7,252.6 330.3,259.2 336.8,277.0 343.4,268.0 350.0,277.0" stroke="#EAFBFF" stroke-opacity="0.95" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" filter="url(#gw-glow)"/>

