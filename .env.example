# GitWrapped environment variables — copy to .env.local for local development.

# GitHub token (required: the GraphQL API does not allow anonymous access).
# Use a fine-grained personal access token with NO permissions — public data only.
# Generate at: https://github.com/settings/personal-access-tokens/new
# Do NOT use a classic token with the 'repo' scope.
GITHUB_TOKEN=your_github_token_here

# Public URL used in copied README snippets and card embeds (optional).
NEXT_PUBLIC_SITE_URL=https://gitwrapped.aryansync.com

# Shared rate limiting across serverless instances (optional).
# Without these, a per-instance in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (safe defaults) — keep false unless you want monitoring in production.
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false

# Required only when Sentry is enabled
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=td-ur
SENTRY_PROJECT=gitwrapped
